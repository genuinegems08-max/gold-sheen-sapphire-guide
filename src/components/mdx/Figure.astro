---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A numbered editorial figure. Figures auto-number via a CSS counter on
 * `.article-body`, so you never pass a number — just drop `<Figure>` in order.
 *
 * Usage in MDX (image imported at top of the file for optimisation):
 *   import stone from '../../assets/images/stone-blue-macro.jpg'
 *   <Figure src={stone} alt="…" caption="What the reader is seeing." credit="Photo: …" />
 *
 * Or with a path to a file in /public (not optimised):
 *   <Figure src="/figures/diagram.svg" alt="…" caption="…" />
 */
interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  credit?: string;
  /** 'wide' bleeds slightly past the text column on large screens. */
  wide?: boolean;
}
const { src, alt, caption, credit, wide = false } = Astro.props;
const isImported = typeof src !== 'string';
---

<figure class:list={['fig', { 'fig--wide': wide }]}>
  {
    isImported ? (
      <Image
        src={src as ImageMetadata}
        alt={alt}
        widths={[500, 800, 1200]}
        sizes="(max-width: 720px) 100vw, 720px"
        loading="lazy"
      />
    ) : (
      <img src={src as string} alt={alt} loading="lazy" decoding="async" />
    )
  }
  {
    (caption || credit) && (
      <figcaption>
        {caption && <span class="fig-caption">{caption}</span>}
        {credit && <span class="fig-credit">{credit}</span>}
      </figcaption>
    )
  }
</figure>

---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { Crumb } from '../components/Breadcrumbs.astro';
import AuthorByline from '../components/AuthorByline.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { getPerson } from '../data/authors';
import { absoluteUrl, isoDate } from '../utils/seo';
import { SITE } from '../consts';

interface RelatedItem {
  href: string;
  title: string;
  kicker?: string;
  description?: string;
}

interface Props {
  entry: CollectionEntry<'guide'>;
  headings: MarkdownHeading[];
  readMins: number;
  breadcrumbs: Crumb[];
  kicker: string;
  related: RelatedItem[];
}

const { entry, headings, readMins, breadcrumbs, kicker, related } = Astro.props;
const d = entry.data;

const author = getPerson(d.author);
const reviewer = d.reviewer ? getPerson(d.reviewer) : null;
const published = isoDate(d.publishDate);
const modified = isoDate(d.updatedDate ?? d.publishDate);
const canonical = d.canonical ?? absoluteUrl(Astro.url.pathname);
const ogImage = d.ogImage ?? SITE.ogImage;

// ── Article schema ──────────────────────────────────────────────────────────
const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': d.type === 'pillar' ? 'Article' : 'Article',
  headline: d.title,
  description: d.description,
  image: [absoluteUrl(ogImage)],
  datePublished: published,
  dateModified: modified,
  inLanguage: SITE.lang,
  author: {
    '@type': 'Person',
    name: author.name,
    ...(author.links && author.links.length ? { url: author.links[0].href } : {}),
  },
  publisher: { '@id': absoluteUrl('/#organization') },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  ...(d.keywords.length ? { keywords: d.keywords.join(', ') } : {}),
  ...(reviewer
    ? { reviewedBy: { '@type': 'Person', name: reviewer.name } }
    : {}),
};

const schema: Record<string, unknown>[] = [articleSchema];

// ── Inline FAQ schema ───────────────────────────────────────────────────────
if (d.faq.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  });
}
---

<BaseLayout
  title={d.title}
  description={d.description}
  canonical={canonical}
  ogImage={ogImage}
  ogType="article"
  publishedTime={published}
  modifiedTime={modified}
  schema={schema}
>
  <article class="article">
    <div class="container article-header">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow article-kicker">{kicker}</span>
      <h1 class="article-title">{d.title}</h1>
      <p class="lead article-standfirst">{d.description}</p>
      <div class="article-byline">
        <AuthorByline
          authorId={d.author}
          reviewerId={d.reviewer}
          publishDate={d.publishDate}
          updatedDate={d.updatedDate}
          readMins={readMins}
        />
      </div>
    </div>

    {
      d.heroImage && (
        <figure class="article-hero">
          <Image
            src={d.heroImage}
            alt={d.heroImageAlt ?? ''}
            widths={[600, 1000, 1400, 1800]}
            sizes="(max-width: 1200px) 100vw, 1160px"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div class="container article-layout">
      <aside class="article-aside">
        <TableOfContents headings={headings} />
      </aside>

      <div class="article-body prose">
        <slot />

        {
          d.faq.length > 0 && (
            <section class="article-faq" aria-labelledby="faq-heading">
              <h2 id="faq-heading">Frequently asked questions</h2>
              <dl>
                {d.faq.map((f) => (
                  <div class="faq-item">
                    <dt>{f.question}</dt>
                    <dd>{f.answer}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }

        <RelatedLinks items={related} />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-header {
    padding-top: var(--space-5);
    padding-bottom: var(--space-4);
    max-width: 860px;
  }

  .article-kicker {
    margin-top: var(--space-3);
  }

  .article-title {
    font-size: var(--fs-h1);
    margin-top: var(--space-2);
    max-width: 20ch;
  }

  .article-standfirst {
    margin-top: var(--space-3);
    max-width: 60ch;
  }

  .article-byline {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  .article-hero {
    margin: var(--space-2) 0 var(--space-5);
  }

  .article-hero :global(img) {
    width: 100%;
    max-height: 62vh;
    object-fit: cover;
    border-block: 1px solid var(--rule);
  }

  .article-layout {
    display: grid;
    gap: var(--space-5);
    align-items: start;
    padding-bottom: var(--space-6);
  }

  @media (min-width: 1000px) {
    .article-layout {
      grid-template-columns: 230px minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  .article-aside {
    display: none;
  }

  @media (min-width: 1000px) {
    .article-aside {
      display: block;
    }
  }

  .article-body {
    max-width: var(--measure);
  }

  /* FAQ block */
  .article-faq {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .article-faq h2 {
    font-size: var(--fs-h2);
    border: 0;
    padding: 0;
    margin-bottom: var(--space-3);
  }

  .faq-item {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }

  .faq-item dt {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--ink);
    margin-bottom: 0.4em;
  }

  .faq-item dd {
    margin: 0;
    color: var(--ink-muted);
  }
</style>

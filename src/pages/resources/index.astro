---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { PILLARS } from '../../consts';
import { absoluteUrl } from '../../utils/seo';
import { RESOURCE_GROUPS, TYPE_LABEL } from '../../data/resources';

const entries = await getCollection('guide', ({ data }) => !data.draft);
const articles = entries.filter((e) => e.data.type === 'article');

// Group this site's own content by pillar (the "on this site" register).
const internalGroups = PILLARS.map((p) => ({
  meta: p,
  hasPillar: entries.some((e) => e.id === p.slug),
  children: articles
    .filter((a) => a.data.pillar === p.slug)
    .sort((a, b) => a.data.order - b.data.order),
})).filter((g) => g.hasPillar);

const referencePages = [
  { title: 'Gemstone glossary', href: '/glossary/', note: 'Every key term, defined and deep-linkable.' },
  { title: 'Frequently asked questions', href: '/faq/', note: 'Short, sourced answers to the common questions.' },
  { title: 'Photographic gallery', href: '/gallery/', note: 'Plates of cuts, colours and inclusion fields.' },
];

// Counts for the header (specific, not decorative).
const internalCount = entries.length + referencePages.length;
const externalCount = RESOURCE_GROUPS.reduce((n, g) => n + g.items.length, 0);
const linkedExternal = RESOURCE_GROUPS.flatMap((g) => g.items).filter((i) => i.url);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Resources', href: '/resources/' },
];

// CollectionPage + ItemList of the linkable external sources.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Gold Sheen Sapphire — Resource Hub',
    description:
      'A single index to everything about Gold Sheen Sapphire: this site’s complete guide plus a curated directory of external papers, laboratories, press and official channels.',
    url: absoluteUrl('/resources/'),
    isPartOf: { '@id': absoluteUrl('/#website') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Gold Sheen Sapphire — external sources',
    numberOfItems: linkedExternal.length,
    itemListElement: linkedExternal.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.title,
      url: item.url,
    })),
  },
];
---

<BaseLayout
  title="Gold Sheen Sapphire Resource Hub — Papers, Labs, Press & Guides"
  description="The complete Gold Sheen Sapphire resource hub: every article on this site plus a curated directory of peer-reviewed papers, gemmological laboratories, press coverage and official channels."
  schema={schema}
>
  <section class="section container">
    <Breadcrumbs items={breadcrumbs} />

    <header class="hub-head reveal">
      <span class="eyebrow">The resource hub · Source of record</span>
      <h1 class="hub-title">Everything on Gold&nbsp;Sheen&nbsp;Sapphire, in one place</h1>
      <p class="lead mt-3">
        One index to it all — this site’s complete guide, and a curated directory
        of the outside sources worth trusting: the peer-reviewed papers,
        laboratories, press and official channels. If it’s on the record, it’s
        linked here.
      </p>
      <dl class="hub-counts" aria-label="What's in the hub">
        <div><dt>{internalCount}</dt><dd>pages on this site</dd></div>
        <div><dt>{externalCount}</dt><dd>external sources</dd></div>
        <div><dt>{RESOURCE_GROUPS.length + 2}</dt><dd>categories</dd></div>
      </dl>
    </header>

    <hr class="sheen-line" style="margin-block: var(--space-4) var(--space-6)" aria-hidden="true" />

    <!-- ── ON THIS SITE ── -->
    <section class="hub-group reveal" aria-labelledby="grp-guide">
      <div class="hub-group-head">
        <span class="hub-num">A</span>
        <div>
          <h2 id="grp-guide" class="hub-group-title">The complete guide, on this site</h2>
          <p class="hub-group-blurb">
            Our own long-form coverage, organised into six pillars. Read the whole
            thing from the <a class="text-link" href="/guide/">article library</a>.
          </p>
        </div>
      </div>

      <div class="hub-rows">
        {
          internalGroups.map((g) => (
            <>
              <a class="res-row res-row--pillar" href={`/guide/${g.meta.slug}/`}>
                <span class="res-main">
                  <span class="res-title">{g.meta.label}</span>
                  <span class="res-note">{g.meta.blurb}</span>
                </span>
                <span class="res-tag res-tag--pillar">Pillar</span>
              </a>
              {g.children.map((a) => (
                <a class="res-row res-row--child" href={`/guide/${a.id}/`}>
                  <span class="res-main">
                    <span class="res-title">{a.data.title}</span>
                    <span class="res-note">{a.data.description}</span>
                  </span>
                  <span class="res-tag">Article</span>
                </a>
              ))}
            </>
          ))
        }
      </div>
    </section>

    <!-- ── REFERENCE PAGES ── -->
    <section class="hub-group reveal" aria-labelledby="grp-ref">
      <div class="hub-group-head">
        <span class="hub-num">B</span>
        <div>
          <h2 id="grp-ref" class="hub-group-title">Reference tools</h2>
          <p class="hub-group-blurb">Look-ups and visual references on this site.</p>
        </div>
      </div>
      <div class="hub-rows">
        {
          referencePages.map((r) => (
            <a class="res-row" href={r.href}>
              <span class="res-main">
                <span class="res-title">{r.title}</span>
                <span class="res-note">{r.note}</span>
              </span>
              <span class="res-tag">Reference</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ── EXTERNAL DIRECTORY ── -->
    {
      RESOURCE_GROUPS.map((group, gi) => (
        <section class="hub-group reveal" aria-labelledby={`grp-${group.id}`}>
          <div class="hub-group-head">
            <span class="hub-num">{String.fromCharCode(67 + gi)}</span>
            <div>
              <h2 id={`grp-${group.id}`} class="hub-group-title">{group.heading}</h2>
              <p class="hub-group-blurb">{group.blurb}</p>
            </div>
          </div>
          <div class="hub-rows">
            {group.items.map((item) =>
              item.url ? (
                <a class="res-row res-row--ext" href={item.url} target="_blank" rel="noopener nofollow">
                  <span class="res-main">
                    <span class="res-title">
                      {item.title}
                      <svg class="res-ext-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <span class="res-note">{item.note}</span>
                    <span class="res-meta">{[item.source, item.year].filter(Boolean).join(' · ')}</span>
                  </span>
                  <span class="res-tag">{TYPE_LABEL[item.type]}</span>
                </a>
              ) : (
                <div class="res-row res-row--cite">
                  <span class="res-main">
                    <span class="res-title res-title--plain">{item.title}</span>
                    <span class="res-note">{item.note}</span>
                    <span class="res-meta">{[item.source, item.year].filter(Boolean).join(' · ')}</span>
                  </span>
                  <span class="res-tags">
                    <span class="res-tag">{TYPE_LABEL[item.type]}</span>
                    <span class="res-tag res-tag--todo">link needed</span>
                  </span>
                </div>
              )
            )}
          </div>
        </section>
      ))
    }

    <p class="hub-foot reveal">
      Know a source we’ve missed? The hub is meant to be exhaustive — send it to
      <a class="text-link" href="mailto:genuinegems08@gmail.com">genuinegems08@gmail.com</a>
      and we’ll add it.
    </p>
  </section>
</BaseLayout>

<style>
  .hub-head {
    max-width: 820px;
  }
  .hub-title {
    font-size: var(--fs-h1);
    margin-top: var(--space-2);
  }

  .hub-counts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin: var(--space-4) 0 0;
  }
  .hub-counts div {
    display: flex;
    flex-direction: column;
  }
  .hub-counts dt {
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 1;
    color: var(--gold-deep);
  }
  .hub-counts dd {
    margin: 0.3rem 0 0;
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  .hub-group {
    margin-bottom: var(--space-6);
  }

  .hub-group-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    margin-bottom: var(--space-3);
  }
  @media (min-width: 640px) {
    .hub-group-head {
      grid-template-columns: 3rem 1fr;
    }
  }
  .hub-num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--gold);
    line-height: 1.1;
  }
  .hub-group-title {
    font-size: var(--fs-h3);
  }
  .hub-group-blurb {
    margin-top: 0.4rem;
    color: var(--ink-muted);
    max-width: 66ch;
    font-family: var(--font-ui);
    font-size: 0.95rem;
  }

  /* Directory rows */
  .hub-rows {
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 640px) {
    .hub-rows {
      margin-left: 3rem;
    }
  }

  .res-row {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
    justify-content: space-between;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--rule);
    transition: background var(--dur-fast) var(--ease-out), padding-left var(--dur-fast) var(--ease-out);
  }
  a.res-row:hover {
    background: var(--paper-2);
    padding-left: 0.75rem;
  }

  .res-row--child {
    padding-left: 1rem;
    border-left: 2px solid var(--rule);
  }
  a.res-row--child:hover {
    border-left-color: var(--gold-line);
  }

  .res-main {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .res-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.2;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  a.res-row:hover .res-title {
    color: var(--gold-ink);
  }
  .res-title--plain {
    color: var(--ink);
  }
  .res-ext-icon {
    width: 12px;
    height: 12px;
    color: var(--gold-deep);
    flex: none;
  }
  .res-note {
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    color: var(--ink-muted);
    max-width: 74ch;
  }
  .res-meta {
    font-family: var(--font-ui);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.04em;
    color: var(--ink-faint);
    text-transform: uppercase;
  }

  .res-tags {
    display: flex;
    gap: 0.4rem;
    flex: none;
  }
  .res-tag {
    flex: none;
    font-family: var(--font-ui);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--ink-muted);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    padding: 0.25em 0.55em;
    height: fit-content;
    white-space: nowrap;
  }
  .res-tag--pillar {
    color: var(--navy);
    border-color: var(--gold-line);
  }
  .res-tag--todo {
    color: var(--danger, #b45a3c);
    border-color: rgba(180, 90, 60, 0.4);
  }

  .hub-foot {
    margin-top: var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }
</style>

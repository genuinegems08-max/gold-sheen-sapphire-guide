---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PILLARS } from '../consts';
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found. Browse the Gold Sheen Sapphire guide instead."
  noindex={true}
>
  <section class="section container notfound">
    <span class="eyebrow">Error 404</span>
    <h1 class="notfound-title">This facet doesn't exist.</h1>
    <p class="lead mt-3">
      The page you were looking for isn't here. It may have moved, or the link
      may be incomplete. Try one of the pillars below.
    </p>
    <div class="notfound-links mt-4">
      <a href="/" class="btn btn-primary">Home</a>
      <a href="/guide/" class="btn btn-ghost">The guide</a>
    </div>
    <ul class="notfound-pillars mt-5">
      {PILLARS.map((p) => <li><a class="text-link" href={`/guide/${p.slug}/`}>{p.label}</a></li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .notfound {
    max-width: 640px;
    padding-block: var(--space-7);
  }
  .notfound-title {
    font-size: var(--fs-h1);
    margin-top: var(--space-2);
  }
  .notfound-links {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .notfound-pillars {
    list-style: none;
    display: grid;
    gap: 0.6rem;
    font-family: var(--font-ui);
  }
</style>

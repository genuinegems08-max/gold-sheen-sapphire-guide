---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { PILLARS } from '../../consts';
import { formatDate } from '../../utils/seo';
import { absoluteUrl } from '../../utils/seo';

const entries = await getCollection('guide', ({ data }) => !data.draft);
const articles = entries.filter((e) => e.data.type === 'article');

// Group each pillar with its spoke articles (topical library structure).
const library = PILLARS.map((p) => {
  const pillarEntry = entries.find((e) => e.id === p.slug);
  const children = articles
    .filter((a) => a.data.pillar === p.slug)
    .sort((a, b) => a.data.order - b.data.order);
  return { meta: p, pillarEntry, children };
}).filter((x) => x.pillarEntry);

const totalArticles = entries.length;
const recent = [...entries]
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 4);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'The Guide', href: '/guide/' },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The Gold Sheen Sapphire Guide — Article Library',
  description:
    'A structured library of articles on Gold Sheen Sapphire, organised into six pillars: what it is, comparisons, buying, care, history, and jewellery.',
  url: absoluteUrl('/guide/'),
  isPartOf: { '@id': absoluteUrl('/#website') },
};
---

<BaseLayout
  title="The Complete Gold Sheen Sapphire Guide — Article Library"
  description="A structured library of in-depth articles on Gold Sheen Sapphire: what it is, how it compares to other sapphires, how to buy and grade it, care, history, and jewellery."
  schema={[collectionSchema]}
>
  <section class="section container">
    <Breadcrumbs items={breadcrumbs} />
    <div class="lib-head reveal">
      <span class="eyebrow">The library · {totalArticles} articles · Six pillars</span>
      <h1 class="lib-title">The Gold&nbsp;Sheen&nbsp;Sapphire library</h1>
      <p class="lead mt-3">
        Every article, organised. Each of the six pillars below is a comprehensive
        guide to its topic; beneath it sit the deeper, more specific articles that
        link back to it. Read a pillar top-to-bottom, or jump straight to a
        question.
      </p>
    </div>

    <hr class="sheen-line" style="margin-block: var(--space-4) 0" aria-hidden="true" />

    <div class="library">
      {
        library.map(({ meta, children }, i) => (
          <section class="lib-section reveal" aria-labelledby={`pillar-${meta.slug}`}>
            <div class="lib-pillar">
              <span class="lib-num">{String(i + 1).padStart(2, '0')}</span>
              <div class="lib-pillar-main">
                <a href={`/guide/${meta.slug}/`} class="lib-pillar-link">
                  <span class="lib-kicker">Pillar</span>
                  <h2 id={`pillar-${meta.slug}`} class="lib-pillar-title">{meta.label}</h2>
                </a>
                <p class="lib-pillar-blurb">{meta.blurb}</p>
                <a href={`/guide/${meta.slug}/`} class="lib-pillar-cta">
                  Read the pillar
                  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4"/></svg>
                </a>
              </div>
            </div>

            {children.length > 0 && (
              <ul class="lib-articles">
                {children.map((a) => (
                  <li>
                    <a href={`/guide/${a.id}/`}>
                      <span class="lib-article-title">{a.data.title}</span>
                      <span class="lib-article-desc">{a.data.description}</span>
                      <span class="lib-article-date">{formatDate(a.data.publishDate)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>
  </section>

  <section class="section container" style="padding-top:0">
    <div class="recent reveal">
      <span class="eyebrow">Recently updated</span>
      <ul class="recent-list mt-3">
        {
          recent.map((a) => (
            <li>
              <a href={`/guide/${a.id}/`}>
                <span class="recent-title">{a.data.title}</span>
                <span class="recent-date">{formatDate(a.data.updatedDate ?? a.data.publishDate)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .lib-head {
    max-width: 780px;
  }
  .lib-title {
    font-size: var(--fs-h1);
    margin-top: var(--space-2);
  }

  .library {
    margin-top: var(--space-5);
  }

  .lib-section {
    padding-block: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  .lib-pillar {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  @media (min-width: 640px) {
    .lib-pillar {
      grid-template-columns: 4.5rem 1fr;
      gap: var(--space-4);
    }
  }

  .lib-num {
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 1;
    color: var(--gold);
  }

  .lib-kicker {
    font-family: var(--font-ui);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-deep);
    font-weight: 600;
  }

  .lib-pillar-title {
    font-size: var(--fs-h2);
    margin-top: 0.2rem;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .lib-pillar-link:hover .lib-pillar-title {
    color: var(--gold-ink);
  }

  .lib-pillar-blurb {
    color: var(--ink-muted);
    margin-top: 0.6rem;
    max-width: 62ch;
    font-size: 1.05rem;
  }

  .lib-pillar-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--gold-ink);
  }

  .lib-pillar-cta svg {
    width: 14px;
    height: 14px;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .lib-pillar-cta:hover svg {
    transform: translateX(3px);
  }

  /* Spoke articles under each pillar */
  .lib-articles {
    list-style: none;
    margin-top: var(--space-3);
    margin-left: 0;
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: 3px;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .lib-articles {
      margin-left: 6.5rem;
    }
  }

  .lib-articles a {
    display: grid;
    gap: 0.2rem;
    padding: var(--space-3);
    background: var(--paper-2);
    transition: background var(--dur-fast) var(--ease-out);
  }

  .lib-articles a:hover {
    background: var(--paper);
  }

  .lib-article-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--ink);
  }

  .lib-articles a:hover .lib-article-title {
    color: var(--gold-ink);
  }

  .lib-article-desc {
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    color: var(--ink-muted);
    max-width: 70ch;
  }

  .lib-article-date {
    font-family: var(--font-ui);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-top: 0.2rem;
  }

  /* Recently updated */
  .recent {
    border-top: 1px solid var(--rule);
    padding-top: var(--space-4);
  }

  .recent-list {
    list-style: none;
    display: grid;
    gap: 0;
    max-width: 820px;
  }

  .recent-list a {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-ui);
  }

  .recent-title {
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .recent-list a:hover .recent-title {
    color: var(--gold-ink);
  }

  .recent-date {
    flex: none;
    font-size: var(--fs-small);
    color: var(--ink-faint);
  }
</style>

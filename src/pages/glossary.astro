---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { GLOSSARY } from '../data/glossary';
import { absoluteUrl } from '../utils/seo';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Glossary', href: '/glossary/' },
];

const bySlug = new Map(GLOSSARY.map((t) => [t.slug, t]));

// DefinedTermSet schema — a clean way to expose a glossary to search engines.
const glossarySchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': absoluteUrl('/glossary/#glossary'),
  name: 'Gold Sheen Sapphire & Gemstone Glossary',
  url: absoluteUrl('/glossary/'),
  hasDefinedTerm: GLOSSARY.map((t) => ({
    '@type': 'DefinedTerm',
    '@id': absoluteUrl(`/glossary/#${t.slug}`),
    name: t.term,
    description: t.definition,
    inDefinedTermSet: absoluteUrl('/glossary/#glossary'),
  })),
};
---

<BaseLayout
  title="Gemstone Glossary — Gold Sheen Sapphire Terms Explained"
  description="A plain-English glossary of gemstone and Gold Sheen Sapphire terminology: chatoyancy, schiller, asterism, silk, corundum, hematite, ilmenite, cabochon and more."
  schema={[glossarySchema]}
>
  <section class="section container">
    <Breadcrumbs items={breadcrumbs} />
    <div class="page-head">
      <span class="eyebrow">Reference</span>
      <h1 class="page-title">Gemstone glossary</h1>
      <p class="lead mt-3">
        The vocabulary of Gold Sheen Sapphire and phenomenal gems, defined
        plainly. Deep-link any term, e.g. <code>/glossary/#chatoyancy</code>.
      </p>
    </div>

    <hr class="sheen-line" style="margin-block: var(--space-4) var(--space-5)" aria-hidden="true" />

    <div class="glossary-index" aria-label="Jump to term">
      {GLOSSARY.map((t) => <a href={`#${t.slug}`}>{t.term}</a>)}
    </div>

    <dl class="glossary">
      {
        GLOSSARY.map((t) => (
          <div class="term" id={t.slug}>
            <dt>{t.term}</dt>
            <dd>
              <p>{t.definition}</p>
              {t.related && t.related.length > 0 && (
                <p class="term-related">
                  See also:
                  {t.related.map((slug, i) => {
                    const r = bySlug.get(slug);
                    return r ? (
                      <>
                        {i > 0 && ', '}
                        <a class="text-link" href={`#${r.slug}`}>{r.term}</a>
                      </>
                    ) : null;
                  })}
                </p>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>

<style>
  .page-head {
    max-width: 720px;
  }
  .page-title {
    font-size: var(--fs-h1);
    margin-top: var(--space-2);
  }
  .page-head code {
    font-size: 0.85em;
    background: var(--paper-3);
    padding: 0.1em 0.4em;
    border-radius: 3px;
  }

  .glossary-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-5);
    max-width: 820px;
  }

  .glossary-index a {
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    color: var(--ink-muted);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.3em 0.7em;
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .glossary-index a:hover {
    border-color: var(--gold-line);
    color: var(--gold-ink);
  }

  .glossary {
    max-width: 760px;
  }

  .term {
    padding-block: var(--space-4);
    border-top: 1px solid var(--rule);
    scroll-margin-top: 6rem;
  }

  .term:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .term dt {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .term dd {
    margin: 0;
    color: var(--ink-muted);
  }

  .term-related {
    margin-top: 0.7rem;
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    color: var(--ink-faint);
  }

  .term:target dt {
    color: var(--gold-ink);
  }
</style>

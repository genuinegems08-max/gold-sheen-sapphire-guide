---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { PILLARS, SITE } from '../consts';
import { pillarShort } from '../utils/guide';
import heroStone from '../assets/images/stone-teardrop-cream.jpg';
import silkMacro from '../assets/images/sheen-gold-silk.jpg';
import galleryTeaser from '../assets/images/stone-gold-oval-inhand.jpg';

const entries = await getCollection('guide', ({ data }) => !data.draft);
const articles = entries.filter((e) => e.data.type === 'article');
const featured = articles
  .filter((e) => e.data.featured)
  .concat(articles)
  .filter((e, i, arr) => arr.findIndex((x) => x.id === e.id) === i)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const pillarEntries = PILLARS.filter((p) => entries.some((e) => e.id === p.slug));
---

<BaseLayout
  title={`${SITE.brand} — ${SITE.tagline}`}
  description={SITE.description}
  isHome={true}
>
  <!-- ══════════════ HERO ══════════════ -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">A finite deposit · Kenya · Now depleted</span>
        <h1 class="hero-title">
          The complete record of a sapphire that
          <em class="serif-italic"> stopped forming.</em>
        </h1>
        <p class="lead hero-lead">
          Gold Sheen Sapphire carries a moving band of golden light — a natural
          schiller thrown by a dense field of hematite and ilmenite needles
          locked inside the crystal. Every stone came from one Kenyan deposit,
          and that deposit is exhausted. This is the definitive guide to what it
          is, how to judge it, and why it cannot be made again.
        </p>
        <div class="hero-actions">
          <a href="/guide/" class="btn btn-primary">
            Read the guide
            <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4"/></svg>
          </a>
          <a href="/guide/what-is-gold-sheen-sapphire/" class="btn btn-ghost">
            Start with the phenomenon
          </a>
        </div>
      </div>

      <figure class="hero-figure reveal">
        <Image
          src={heroStone}
          alt="Polished Gold Sheen Sapphire teardrop cabochon showing banded blue body colour crossed by a golden sheen"
          widths={[400, 700, 900]}
          sizes="(max-width: 1024px) 90vw, 460px"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>Teardrop cabochon — the sheen crosses the long axis as the stone tilts.</figcaption>
      </figure>
    </div>
    <hr class="sheen-line" aria-hidden="true" />
  </section>

  <!-- ══════════════ WHY IT MATTERS ══════════════ -->
  <section class="section container">
    <div class="facts-grid">
      <div class="facts-intro reveal">
        <span class="eyebrow">Why it's unrepeatable</span>
        <h2 class="section-title">Three facts that fix its value</h2>
        <p class="text-muted mt-3">
          Rarity here isn't a marketing claim — it's geology and supply. Each
          point below opens into a pillar of the guide.
        </p>
      </div>
      <dl class="facts">
        <div class="fact reveal">
          <dt>The phenomenon</dt>
          <dd>
            A natural schiller — not a treatment, coating, or star. Oriented
            hematite–ilmenite platelets scatter light into a soft golden sheen.
            <a class="text-link" href="/guide/what-is-gold-sheen-sapphire/">How the sheen forms →</a>
          </dd>
        </div>
        <div class="fact reveal">
          <dt>The origin</dt>
          <dd>
            A single deposit in north-east Kenya, near the Somali border —
            geographically specific from the very start.
            <a class="text-link" href="/guide/gold-sheen-sapphire-history-and-significance/">The discovery →</a>
          </dd>
        </div>
        <div class="fact reveal">
          <dt>The scarcity</dt>
          <dd>
            That deposit is depleted. No new material is entering the market;
            what exists is the whole of what ever will.
            <a class="text-link" href="/guide/gold-sheen-sapphire-buying-guide/">What that means for price →</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ══════════════ IMAGE BAND ══════════════ -->
  <figure class="image-band">
    <Image
      src={silkMacro}
      alt="Macro photograph of golden hematite and ilmenite silk inclusions inside Gold Sheen Sapphire, the origin of the sheen"
      widths={[800, 1200, 1800]}
      sizes="100vw"
      loading="lazy"
    />
    <figcaption class="image-band-cap">
      <span class="eyebrow eyebrow--plain">Under magnification</span>
      <p>The sheen has a cause you can see: a dense, oriented field of metallic needles suspended in the corundum.</p>
    </figcaption>
  </figure>

  <!-- ══════════════ PILLARS ══════════════ -->
  <section class="section container">
    <div class="section-head reveal">
      <span class="eyebrow">The six pillars</span>
      <h2 class="section-title">Where to begin</h2>
      <p class="text-muted mt-3">Each pillar is a comprehensive, standalone guide. Together they form the complete reference.</p>
    </div>
    <ul class="pillar-cards mt-4">
      {
        pillarEntries.map((p, i) => (
          <li class="reveal">
            <a href={`/guide/${p.slug}/`} class="pillar-card">
              <span class="pillar-card-num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="pillar-card-title">{p.label}</h3>
              <p class="pillar-card-blurb">{p.blurb}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ══════════════ FEATURED ARTICLES ══════════════ -->
  {
    featured.length > 0 && (
      <section class="section container" style="padding-top:0">
        <div class="section-head reveal">
          <span class="eyebrow">From the guide</span>
          <h2 class="section-title">Featured reading</h2>
        </div>
        <div class="grid grid-3 mt-4">
          {featured.map((a) => (
            <ArticleCard
              href={`/guide/${a.id}/`}
              title={a.data.title}
              description={a.data.description}
              kicker={pillarShort(a.data.pillar)}
              image={a.data.heroImage}
              imageAlt={a.data.heroImageAlt}
              date={a.data.publishDate}
            />
          ))}
        </div>
      </section>
    )
  }

  <!-- ══════════════ GALLERY TEASER ══════════════ -->
  <section class="section container" style="padding-top:0">
    <div class="gallery-teaser reveal">
      <div class="gallery-teaser-media">
        <Image
          src={galleryTeaser}
          alt="Large oval Gold Sheen Sapphire held in hand, golden sheen crossing the surface"
          widths={[500, 800, 1100]}
          sizes="(max-width: 900px) 100vw, 560px"
          loading="lazy"
        />
      </div>
      <div class="gallery-teaser-copy">
        <span class="eyebrow">Plates</span>
        <h2 class="section-title">See the sheen move</h2>
        <p class="text-muted mt-3">
          A photographic study of cuts, body colours and inclusion fields — each
          plate annotated with what to look for.
        </p>
        <a href="/gallery/" class="btn btn-ghost mt-4">
          Open the gallery
          <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4"/></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-top: var(--space-6);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    padding-bottom: var(--space-6);
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-6);
    }
  }

  .hero-title {
    font-size: var(--fs-display);
    letter-spacing: -0.02em;
    margin-top: var(--space-3);
    max-width: 15ch;
  }

  .hero-lead {
    margin-top: var(--space-4);
    max-width: 54ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .hero-figure {
    margin: 0;
  }

  .hero-figure :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--rule);
    border-radius: 3px;
    box-shadow: 0 40px 80px -50px rgba(28, 23, 18, 0.7);
  }

  .hero-figure figcaption {
    margin-top: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  .section-title {
    font-size: var(--fs-h2);
    margin-top: var(--space-2);
  }

  .section-head {
    max-width: 720px;
  }

  /* Facts */
  .facts-grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 960px) {
    .facts-grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--space-6);
    }
  }

  .facts {
    display: grid;
    gap: 0;
  }

  .fact {
    padding-block: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  .fact:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .fact dt {
    font-family: var(--font-ui);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-deep);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .fact dd {
    margin: 0;
    color: var(--ink);
  }

  .fact dd a {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    font-weight: 600;
  }

  /* Image band */
  .image-band {
    position: relative;
    margin: var(--space-2) 0;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border-block: 1px solid var(--rule);
  }

  .image-band :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-band-cap {
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: var(--space-3);
    max-width: 44ch;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: blur(6px);
    border-left: 2px solid var(--gold);
    padding: var(--space-2) var(--space-3);
  }

  @media (min-width: 768px) {
    .image-band-cap {
      left: var(--space-5);
      bottom: var(--space-5);
    }
  }

  .image-band-cap p {
    margin-top: 0.4rem;
    font-size: 1rem;
    color: var(--ink);
  }

  /* Pillar cards */
  .pillar-cards {
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .pillar-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 980px) {
    .pillar-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pillar-card {
    display: block;
    height: 100%;
    padding: var(--space-4);
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--paper-2);
    transition: border-color var(--dur-med) var(--ease-out), transform var(--dur-med) var(--ease-out);
  }

  .pillar-card:hover {
    border-color: var(--gold-line);
    transform: translateY(-3px);
  }

  .pillar-card-num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--gold-deep);
  }

  .pillar-card-title {
    font-size: 1.35rem;
    margin-top: var(--space-2);
  }

  .pillar-card-blurb {
    color: var(--ink-muted);
    font-size: 1rem;
    margin-top: 0.6rem;
  }

  /* Gallery teaser */
  .gallery-teaser {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    border: 1px solid var(--rule);
    border-radius: 3px;
    overflow: hidden;
    background: var(--paper-2);
  }

  @media (min-width: 820px) {
    .gallery-teaser {
      grid-template-columns: 1fr 1fr;
    }
  }

  .gallery-teaser-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .gallery-teaser-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-teaser-copy {
    padding: var(--space-5);
  }
</style>

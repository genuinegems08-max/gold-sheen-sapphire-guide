---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { GALLERY } from '../data/gallery';
import { absoluteUrl } from '../utils/seo';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Gallery', href: '/gallery/' },
];

const gallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  '@id': absoluteUrl('/gallery/#gallery'),
  name: 'Gold Sheen Sapphire — Photographic Plates',
  description:
    'A photographic study of Gold Sheen Sapphire: cuts, body colours and inclusion fields, annotated with what to look for.',
  url: absoluteUrl('/gallery/'),
};
---

<BaseLayout
  title="Gold Sheen Sapphire Gallery — Photographic Plates"
  description="A photographic study of Gold Sheen Sapphire — cabochon cuts, blue and gold body colours, and the hematite–ilmenite inclusion fields that create the sheen. Click any plate to enlarge."
  schema={[gallerySchema]}
>
  <section class="section container">
    <Breadcrumbs items={breadcrumbs} />
    <div class="page-head">
      <span class="eyebrow">Plates</span>
      <h1 class="page-title">The gallery</h1>
      <p class="lead mt-3">
        Cuts, body colours and inclusion fields — photographed to show how the
        sheen behaves. Select any plate to view it larger.
      </p>
    </div>

    <hr class="sheen-line" style="margin-block: var(--space-4) var(--space-5)" aria-hidden="true" />

    <ul class="gallery-grid">
      {
        GALLERY.map((img, i) => (
          <li class="gallery-item">
            <button
              class="gallery-trigger"
              data-index={i}
              aria-label={`Enlarge: ${img.caption}`}
            >
              <Image
                src={img.src}
                alt={img.alt}
                widths={[300, 500, 700]}
                sizes="(max-width: 640px) 100vw, (max-width: 980px) 50vw, 33vw"
                loading={i < 3 ? 'eager' : 'lazy'}
              />
              <span class="gallery-cap">
                <span class="gallery-plate">{img.plate}</span>
                <span class="gallery-caption">{img.caption}</span>
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Lightbox -->
  <dialog class="lightbox" id="lightbox" aria-label="Image viewer">
    <button class="lightbox-close" aria-label="Close viewer">✕</button>
    <button class="lightbox-nav lightbox-prev" aria-label="Previous image">‹</button>
    <figure class="lightbox-figure">
      <img class="lightbox-img" src="" alt="" />
      <figcaption class="lightbox-cap"></figcaption>
    </figure>
    <button class="lightbox-nav lightbox-next" aria-label="Next image">›</button>
  </dialog>

  {/* Full-size sources for the lightbox (kept out of the layout flow) */}
  <script type="application/json" id="gallery-data" is:inline set:html={JSON.stringify(
    GALLERY.map((g) => ({ src: g.src.src, alt: g.alt, caption: g.caption, plate: g.plate }))
  )} />
</BaseLayout>

<style>
  .page-head {
    max-width: 720px;
  }
  .page-title {
    font-size: var(--fs-h1);
    margin-top: var(--space-2);
  }

  .gallery-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
  }

  @media (min-width: 700px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-3);
    }
  }

  .gallery-item {
    position: relative;
  }

  .gallery-trigger {
    display: block;
    width: 100%;
    padding: 0;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 3px;
    aspect-ratio: 4 / 5;
    cursor: zoom-in;
    background: var(--paper-3);
  }

  .gallery-trigger :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }

  .gallery-trigger:hover :global(img) {
    transform: scale(1.05);
  }

  .gallery-cap {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--space-3) var(--space-2) var(--space-2);
    text-align: left;
    background: linear-gradient(to top, color-mix(in srgb, var(--ink) 78%, transparent), transparent);
  }

  .gallery-plate {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--fs-eyebrow);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-bright);
  }

  .gallery-caption {
    display: block;
    font-family: var(--font-display);
    font-size: 0.98rem;
    color: #fdfaf3;
    margin-top: 2px;
    line-height: 1.2;
  }

  /* Lightbox */
  .lightbox {
    border: none;
    padding: 0;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    background: color-mix(in srgb, var(--ink) 94%, black);
    color: var(--paper);
  }

  .lightbox::backdrop {
    background: rgba(10, 9, 8, 0.9);
  }

  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-figure {
    margin: 0;
    max-width: min(1100px, 92vw);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 2px;
  }

  .lightbox-cap {
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    color: var(--ink-faint);
    text-align: center;
  }

  .lightbox-close {
    position: fixed;
    top: 1rem;
    right: 1.2rem;
    font-size: 1.5rem;
    color: var(--paper);
    line-height: 1;
    z-index: 2;
  }

  .lightbox-nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    font-size: 2.5rem;
    color: var(--paper);
    padding: 0.4em;
    opacity: 0.7;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .lightbox-nav:hover {
    opacity: 1;
  }

  .lightbox-prev {
    left: 0.5rem;
  }
  .lightbox-next {
    right: 0.5rem;
  }
</style>

<script>
  interface Plate { src: string; alt: string; caption: string; plate: string }
  const dataEl = document.getElementById('gallery-data');
  const plates: Plate[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const imgEl = dialog?.querySelector<HTMLImageElement>('.lightbox-img');
  const capEl = dialog?.querySelector<HTMLElement>('.lightbox-cap');
  let index = 0;

  const show = (i: number) => {
    if (!plates.length || !imgEl || !capEl) return;
    index = (i + plates.length) % plates.length;
    const p = plates[index];
    imgEl.src = p.src;
    imgEl.alt = p.alt;
    capEl.textContent = `${p.plate} — ${p.caption}`;
  };

  if (dialog && imgEl && capEl) {
    document.querySelectorAll<HTMLButtonElement>('.gallery-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        show(Number(btn.dataset.index));
        dialog.showModal();
      });
    });
    dialog.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lightbox-next')?.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.lightbox-prev')?.addEventListener('click', () => show(index - 1));
    dialog.addEventListener('click', (e) => {
      // click on the backdrop area (the dialog itself) closes
      if (e.target === dialog) dialog.close();
    });
    document.addEventListener('keydown', (e) => {
      if (!dialog.open) return;
      if (e.key === 'ArrowRight') show(index + 1);
      if (e.key === 'ArrowLeft') show(index - 1);
    });
  }
</script>
